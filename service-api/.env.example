# =============================================================================
# CarPass - variaveis de ambiente da API
#
# Copie este arquivo para .env (que esta no .gitignore) e preencha os valores.
# Nenhum destes valores deve ser versionado.
# =============================================================================

# --- Banco de dados ----------------------------------------------------------
CARPASS_DB_URL=jdbc:postgresql://localhost:5432/carpass
CARPASS_DB_USERNAME=postgres
CARPASS_DB_PASSWORD=troque-por-uma-senha-forte

# --- Seguranca ---------------------------------------------------------------
# Gere um segredo aleatorio com pelo menos 32 caracteres:
#   openssl rand -base64 48
# A aplicacao se recusa a subir com um segredo curto ou ausente.
CARPASS_JWT_SECRET=

# Validade do token de acesso, em segundos (8 horas por padrao).
CARPASS_JWT_EXPIRATION_SECONDS=28800

# Origens autorizadas a chamar a API, separadas por virgula. Nunca use '*'.
CARPASS_ALLOWED_ORIGINS=http://localhost:4200

# URL do frontend, usada para montar o link de redefinicao de senha.
CARPASS_FRONTEND_URL=http://localhost:4200

# --- E-mail ------------------------------------------------------------------
# Com false, os e-mails aparecem apenas no log da aplicacao.
CARPASS_MAIL_ENABLED=false
CARPASS_MAIL_FROM=nao-responda@carpass.app
CARPASS_MAIL_HOST=smtp.gmail.com
CARPASS_MAIL_PORT=587
CARPASS_MAIL_USERNAME=
CARPASS_MAIL_PASSWORD=
